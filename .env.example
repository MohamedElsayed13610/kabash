# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PLACEHOLDERS: replace with the real numbers (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=20XXXXXXXXXX
NEXT_PUBLIC_PHONE_NUMBER=0XXXXXXXXXX

# Used to hash IPs for rate limiting (any long random string)
RATE_LIMIT_SALT=change-me
